[Unit]
Description=NodeWall agent
# Do not wait for network-online.target. On hosts with a stale NFS mount that
# target can block boot and make NodeWall install/update appear hung. The
# agent binds locally first and retries manager connectivity after startup.
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/nodewall
EnvironmentFile=-/etc/nodewall/nodewall.env
ExecStart=/opt/nodewall/bin/nodewall agent
Restart=on-failure
LimitMEMLOCK=infinity
Environment=NODEWALL_BPF_OBJECT=/opt/nodewall/bpf/gen/xdpacl_bpfel.o

[Install]
WantedBy=multi-user.target
