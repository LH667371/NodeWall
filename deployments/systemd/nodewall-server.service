[Unit]
Description=NodeWall server
# network-online.target may wait indefinitely for an unavailable NFS mount.
# NodeWall's HTTP and gRPC listeners can start on network.target and clients
# will retry remote enrollment/connectivity independently.
After=network.target nodewall-agent.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/nodewall
EnvironmentFile=-/etc/nodewall/nodewall.env
ExecStart=/opt/nodewall/bin/nodewall server
Restart=on-failure

[Install]
WantedBy=multi-user.target
