# Demo mode: works on macOS or non-privileged hosts.
NODEWALL_DEV_MODE=demo
NODEWALL_DATAPLANE=mock
NODEWALL_SERVER_ADDR=127.0.0.1:8080
NODEWALL_AGENT_ADDR=127.0.0.1:9080
NODEWALL_AGENT_URL=http://127.0.0.1:9080
NODEWALL_AGENT_STATE_DEMO=tmp/agent-demo-state.json

# Real mode: Linux only, requires generated BPF object and suitable privileges.
# NODEWALL_DEV_MODE=real
# NODEWALL_DATAPLANE=real
# NODEWALL_AGENT_STATE_REAL=tmp/agent-real-state.json
